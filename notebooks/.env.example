# actBI Notebooks environment variables
# Copy to .env and fill in values

# -----------------------------------------------------------------------------
# Environment (when using XLake)
# -----------------------------------------------------------------------------
# development | staging | production
# Drives XLake backend choice (local vs cloud) via load_stores_config
APP_ENV=development

# -----------------------------------------------------------------------------
# Data Assets (shared.data)
# -----------------------------------------------------------------------------
# Path to data assets (relative to where you run jupyter from)
ACTBI_DATA_PATH=../pipelines/_data/assets

# Supabase S3 Credentials (for dev environment)
# Get credentials from your Supabase project settings
# Only needed if using: data.use_env('dev')
SUPABASE_S3_ACCESS_KEY=your-access-key
SUPABASE_S3_SECRET_KEY=your-secret-key

# -----------------------------------------------------------------------------
# LLM API Keys (when running agents in notebooks)
# -----------------------------------------------------------------------------
# At least one provider key is needed depending on AGENT_MODEL
ANTHROPIC_API_KEY=your_anthropic_api_key
GOOGLE_API_KEY=your_google_api_key
OPENAI_API_KEY=your_openai_api_key

# -----------------------------------------------------------------------------
# Agents (when running agents in notebooks)
# -----------------------------------------------------------------------------
# AGENT_MODEL=google:gemini-3-flash-preview

# -----------------------------------------------------------------------------
# XLake (when using xlake in notebooks)
# -----------------------------------------------------------------------------
# Local development defaults work out-of-the-box. Override if needed:
# XLAKE_LOCAL_SQLITE_PATH=app_logic.db
# XLAKE_LOCAL_DUCKDB_PATH=datalake.duckdb
# XLAKE_LOCAL_DOC_DIR=.xlake_doc_store
# XLAKE_LOCAL_QDRANT_PATH=:memory:
# XLAKE_LOCAL_CONTEXT_SNAPSHOTS_DIR=.xlake_context_store
# XLAKE_LOCAL_CHART_DATA_DIR=.xlake_chart_data

# Customer/Core cloud vars (staging/production only; set when APP_ENV is not development)
# XLAKE_CUSTOMER_SUPABASE_URL=
# XLAKE_CUSTOMER_SUPABASE_SERVICE_KEY=
# XLAKE_CORE_CONTEXT_QDRANT_URL=
# XLAKE_CORE_CONTEXT_QDRANT_API_KEY=
# ... (see service/.env.example for full XLake var list)
