# actBI Pipelines (Dagster) environment variables
# Copy to .env and fill in your actual values
# .env is git-ignored and will not be committed

# -----------------------------------------------------------------------------
# Data Source API Keys
# -----------------------------------------------------------------------------
# FRED (Federal Reserve Economic Data) API Key
# Get your API key at: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_fred_api_key_here

# BLS (Bureau of Labor Statistics) API Key
# Register for free at: https://data.bls.gov/registrationEngine/
BLS_API_KEY=your_bls_api_key_here

# BLS User Agent for Bulk FTP Downloads
# Format: "Your Name your.email@domain.com" (required by BLS for bulk downloads)
# BLS requires contact info in User-Agent header per their data use policy
BLS_USER_AGENT="Your Name your.email@domain.com"

# BEA (Bureau of Economic Analysis) API Key
# Get your API key at: https://apps.bea.gov/api/signup/
BEA_API_KEY=your_bea_api_key_here

# USDA FAS (Foreign Agricultural Service) API Key
# Get your API key at: https://api.data.gov/signup/
USDA_FAS_API_KEY=your_usda_fas_api_key_here


# NOAA Climate Data Online (CDO) API Token
# Request token at: https://www.ncdc.noaa.gov/cdo-web/token
NOAA_API_TOKEN=your_noaa_api_token_here

# SEC EDGAR API Identity
# Format: "Your Name email@domain.com" (required by SEC for all API requests)
# No API key needed - SEC EDGAR is free, but requires contact info
SEC_IDENTITY="Your Name your.email@domain.com"

# -----------------------------------------------------------------------------
# Storage Configuration (shared.data)
# -----------------------------------------------------------------------------
# Storage environment: 'local' (default) or 'dev' (Supabase S3)
STORAGE_ENV=local

# Supabase S3 Credentials (only needed for STORAGE_ENV=dev)
# Get credentials from your Supabase project settings
SUPABASE_S3_ACCESS_KEY=your-access-key
SUPABASE_S3_SECRET_KEY=your-secret-key

# -----------------------------------------------------------------------------
# Dagster Configuration
# -----------------------------------------------------------------------------
# DAGSTER_HOME defines where Dagster stores run history, schedules, and metadata
# IMPORTANT: Must be an absolute path (Dagster requirement)
# Run: echo "DAGSTER_HOME=$(pwd)/.dagster" >> .env
# For shared Postgres storage, use .dagster-dev instead (requires DAGSTER_PG_* vars below)
DAGSTER_HOME=/path/to/pipelines/.dagster

# Supabase Postgres credentials (only needed for DAGSTER_HOME=.dagster-dev)
# Host format: db.<project-ref>.supabase.co (NOT the full https:// URL)
# Find in Supabase Dashboard > Settings > Database > Connection string
# Note: Database password is separate from S3 access keys
DAGSTER_PG_HOST=db.<project-ref>.supabase.co
DAGSTER_PG_PORT=5432
DAGSTER_PG_DB=postgres
DAGSTER_PG_USERNAME=postgres
DAGSTER_PG_PASSWORD=your-database-password
