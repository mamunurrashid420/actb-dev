# actBI Service (FastAPI) environment variables
# Copy to .env and fill in values

# -----------------------------------------------------------------------------
# Environment
# -----------------------------------------------------------------------------
# development | staging | production
# Drives container selection and XLake backend choice (local vs cloud)
APP_ENV=development

# -----------------------------------------------------------------------------
# Supabase (required)
# -----------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_LEEWAY_SECONDS=10

# -----------------------------------------------------------------------------
# App Security
# -----------------------------------------------------------------------------
APP_KMS_KEY=

# -----------------------------------------------------------------------------
# Storage
# -----------------------------------------------------------------------------
STORAGE_BACKEND=supabase
STORAGE_BUCKET=tenant-assets
STORAGE_SIGNED_URL_TTL_SECONDS=3600

# -----------------------------------------------------------------------------
# API Settings
# -----------------------------------------------------------------------------
# Comma-separated CORS origins (default: http://localhost:3000,http://localhost:3001)
# CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Set to "on" to enable dev-only playground routes (e.g. viz_designer)
# PLAYGROUND=on

# DEBUG=false

# -----------------------------------------------------------------------------
# LLM API Keys (required for agents)
# -----------------------------------------------------------------------------
# At least one provider key is needed depending on AGENT_MODEL / AGENT_VIZ_DESIGNER_DEFAULT_MODEL
ANTHROPIC_API_KEY=your_anthropic_api_key
GOOGLE_API_KEY=your_google_api_key
OPENAI_API_KEY=your_openai_api_key

# -----------------------------------------------------------------------------
# Agents
# -----------------------------------------------------------------------------
# Default model for all agents (format: provider:model)
# AGENT_MODEL=google:gemini-3-flash-preview

# Viz Designer agent (AGENT_VIZ_DESIGNER_*)
# AGENT_VIZ_DESIGNER_DEFAULT_MODEL=anthropic:claude-sonnet-4-20250514
# AGENT_VIZ_DESIGNER_DEBUG=false
# AGENT_VIZ_DESIGNER_SELECTION_MODEL=
# AGENT_VIZ_DESIGNER_REFINEMENT_MODEL=
# AGENT_VIZ_DESIGNER_TEMPERATURE=0.0
# AGENT_VIZ_DESIGNER_MAX_TOKENS=4000

# -----------------------------------------------------------------------------
# XLake (service hosts xlake client)
# -----------------------------------------------------------------------------
# Local development (defaults work out-of-the-box)
# XLAKE_LOCAL_SQLITE_PATH=app_logic.db
# XLAKE_LOCAL_DUCKDB_PATH=datalake.duckdb
# XLAKE_LOCAL_DOC_DIR=.xlake_doc_store
# XLAKE_LOCAL_QDRANT_PATH=:memory:
# XLAKE_LOCAL_CONTEXT_SNAPSHOTS_DIR=.xlake_context_store
# XLAKE_LOCAL_CHART_DATA_DIR=.xlake_chart_data

# Customer cloud (staging/production only; set when APP_ENV is not development)
# XLAKE_CUSTOMER_SUPABASE_URL=
# XLAKE_CUSTOMER_SUPABASE_SERVICE_KEY=
# XLAKE_CUSTOMER_SUPABASE_SCHEMA=public
# XLAKE_CUSTOMER_QDRANT_URL=
# XLAKE_CUSTOMER_QDRANT_API_KEY=
# XLAKE_CUSTOMER_CONTEXT_SNAPSHOTS_BASE_URI=
# XLAKE_CUSTOMER_CHART_DATA_OBJECT_BASE_URI=
# XLAKE_CUSTOMER_CONNECTORS_REGISTRY_URI=
# XLAKE_CUSTOMER_DOC_OBJECT_BASE_URI=
# XLAKE_CUSTOMER_CONTEXT_STORE_SCHEMA_EMBEDDER=fields_and_facts
# XLAKE_CUSTOMER_EMBEDDING_MODEL=fastembed:BAAI/bge-small-en-v1.5

# Core context (staging/production only)
# XLAKE_CORE_CONTEXT_QDRANT_URL=
# XLAKE_CORE_CONTEXT_QDRANT_API_KEY=
# XLAKE_CORE_CONTEXT_QDRANT_LOCAL_PATH=:memory:
# XLAKE_CORE_CONTEXT_LOCAL_DIR=.xlake_core_context
# XLAKE_CORE_CONTEXT_OBJECT_BASE_URI=
# XLAKE_CORE_CONTEXT_SQLITE_PATH=core_context.db
# XLAKE_CORE_CONTEXT_EMBEDDING_STRATEGY=fields_and_facts
# XLAKE_CORE_EMBEDDING_MODEL=fastembed:BAAI/bge-small-en-v1.5
# XLAKE_CORE_SUPABASE_URL=
# XLAKE_CORE_SUPABASE_SERVICE_KEY=
# XLAKE_CORE_SUPABASE_SCHEMA=public

# Core external (staging/production only)
# XLAKE_CORE_EXTERNAL_DUCKDB_PATH=core_external.duckdb
# XLAKE_CORE_EXTERNAL_LOCAL_DIR=.xlake_core_external
# XLAKE_CORE_EXTERNAL_OBJECT_BASE_URI=
# XLAKE_CORE_EXTERNAL_CLICKHOUSE_URL=
# XLAKE_CORE_EXTERNAL_CLICKHOUSE_DATABASE=default
# XLAKE_CORE_EXTERNAL_CLICKHOUSE_USERNAME=
# XLAKE_CORE_EXTERNAL_CLICKHOUSE_PASSWORD=
# XLAKE_CORE_EXTERNAL_TINYBIRD_URL=
# XLAKE_CORE_EXTERNAL_TINYBIRD_TOKEN=
# XLAKE_CORE_EXTERNAL_TINYBIRD_WORKSPACE=
