# Viz Designer Eval Template
# Copy this file's contents to .env.local, then add your API keys below.
#
# Usage:
#   1. cp .env.viz_designer .env.local  (or copy contents)
#   2. Add your API keys at the bottom
#   3. Run: just dev-api
#   4. Run chartviz: pnpm --filter '@actbi/chartviz' dev
#   5. Open http://localhost:3003/eval

# Enable playground routes
PLAYGROUND=on

# ============================================================================
# LLM API Keys - ADD YOUR KEYS HERE
# ============================================================================

# At least one of these is required for the viz_designer agent:
# NOTE: Default model is gpt-4o-mini, so OPENAI_API_KEY is required unless you
# override AGENT_VIZ_DESIGNER_DEFAULT_MODEL below.
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=

# Optional: Override default model (format: provider:model)
# AGENT_VIZ_DESIGNER_DEFAULT_MODEL=anthropic:claude-sonnet-4-20250514
