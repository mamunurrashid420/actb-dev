# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Site URL (Important for OAuth!)
# Local: http://localhost:3000
# Production: https://bi-ten.vercel.app (or your actual Vercel URL)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# BI App URL (for invite redirects)
# Invites from Admin should redirect users to the BI app
# Local: http://localhost:3001 (if BI runs on different port)
# Production: https://your-bi-app.vercel.app
NEXT_PUBLIC_BI_URL=http://localhost:3001

# Resend Email Configuration
EMAIL_FROM="BI Platform <noreply@yourdomain.com>"
