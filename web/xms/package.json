{
  "name": "@actbi/xms",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "supa:link": "supabase link --project-ref $SUPABASE_PROJECT_REF",
    "mig:new": "sh -c 'supabase migration new ${npm_config_name:-manual_change}'",
    "mig:pull": "sh -c 'supabase db pull ${npm_config_name:-remote_change} --linked'",
    "mig:push": "supabase db push --linked",
    "mig:list": "supabase migration list --linked",
    "types:remote": "supabase gen types --linked --lang typescript -s public > src/types/supabase.ts",
    "schema:dump": "supabase db dump --schema public --file supabase/schema.snapshot.sql",
    "schema:verify": "pnpm schema:dump && git diff --exit-code -- supabase/schema.snapshot.sql"
  },
  "dependencies": {
    "@actbi/shared": "workspace:*",
    "@hookform/resolvers": "^3.10.0",
